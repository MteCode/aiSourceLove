# ---------- 缘桥 环境变量样例 ----------
# 复制为 .env 后按需修改： cp .env.example .env

# ===== 基础 =====
NODE_ENV=development
# 后端监听端口
SERVER_PORT=3000
# 后端对外基础路径
API_PREFIX=/api
# 对外可访问的站点地址（生成图片绝对地址、支付回调用）
PUBLIC_BASE_URL=http://localhost:3000

# ===== 数据库 (MySQL 8) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yuanqiao
MYSQL_USER=yuanqiao
MYSQL_PASSWORD=yuanqiao_dev_pwd
MYSQL_ROOT_PASSWORD=root_dev_pwd
# Prisma 连接串（由上面几项拼成，改了上面记得同步这里）
DATABASE_URL="mysql://yuanqiao:yuanqiao_dev_pwd@127.0.0.1:3306/yuanqiao"

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
# 生产务必替换：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== 文件存储 =====
# local | oss  （MVP 用 local，落盘到 apps/server/uploads）
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ===== AI =====
# mock | openai-compatible
# mock: 无需 key，用确定性伪向量，本地/演示可直接跑
# openai-compatible: DeepSeek / 通义 / Kimi / OpenAI 均走这个协议
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
# 对话和向量是两条独立通道，可以来自不同厂商。
# 向量必须显式填 AI_EMBEDDING_API_KEY 才会启用真模型——不会从对话 key 推导，
# 因为对话供应商常常根本没有 embedding 接口（DeepSeek 没有，多数中转分组也没有），
# 推导过去只会让每次匹配都去打一个 404/503 的地址。留空则向量走 mock。
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024
# embedding 接口单次条数上限：通义 25，OpenAI 2048。取小的更安全
AI_EMBEDDING_BATCH_SIZE=25
# 单次请求超时。推理型模型出字慢，20 秒会把正常请求判成超时
AI_TIMEOUT_MS=60000

# ===== 支付 =====
# mock | wechat   （mock 提供一个"我已支付"的模拟回调，便于本地跑通链路）
PAY_PROVIDER=mock
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify/wechat

# ===== 微信小程序 =====
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=

# ===== 短信验证码 =====
# mock 时验证码固定为 SMS_MOCK_CODE，且会打到后端日志
SMS_PROVIDER=mock
SMS_MOCK_CODE=8888

# ===== 管理后台默认账号（仅 seed 时使用）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
