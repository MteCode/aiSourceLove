    { "path": "pages/profile/detail", "style": { "navigationBarTitleText": "TA 的资料" } },
    { "path": "pages/profile/edit", "style": { "navigationBarTitleText": "我的资料" } },
    { "path": "pages/profile/preference", "style": { "navigationBarTitleText": "择偶要求" } },
    { "path": "pages/profile/photos", "style": { "navigationBarTitleText": "我的照片" } },
